{
  "name": "auto-test-platform",
  "version": "1.0.0",
  "private": true,
  "description": "自动化测试平台 - 支持接口/Web/UI自动化测试",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server/index.ts",
    "agent": "tsx src/agent-web/index.ts",
    "dev:agent": "tsx watch src/agent-web/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "build:agent": "tsc -p tsconfig.agent.json",
    "build:agent-mobile": "tsc -p tsconfig.agent-mobile.json",
    "build:agent-pc": "tsc -p tsconfig.agent-pc.json",
    "start": "node dist/server/index.js",
    "start:agent": "node dist/agent-web/index.js",
    "test": "tsx src/server/engine/_phase2_smoke.ts",
    "setup:drivers": "node scripts/install-playwright-drivers.mjs",
    "postinstall": "node scripts/install-playwright-drivers.mjs && node scripts/setup-git-hooks.mjs",
    "db:generate": "drizzle-kit generate",
    "db:init": "tsx scripts/team-db-init.ts",
    "db:studio": "drizzle-kit studio",
    "team:smoke": "tsx scripts/team-smoke.ts",
    "team:verify-db": "bash scripts/team-verify-db.sh"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@midscene/android": "^1.9.1",
    "@midscene/computer": "^1.9.1",
    "@midscene/core": "^1.9.1",
    "@midscene/harmony": "^1.9.1",
    "@midscene/ios": "^1.9.1",
    "@midscene/web": "^1.9.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@uiw/react-codemirror": "^4.25.9",
    "@xyflow/react": "^12.10.2",
    "@yume-chan/adb": "^2.6.3",
    "@yume-chan/adb-scrcpy": "^2.3.2",
    "@yume-chan/adb-server-node-tcp": "2.5.2",
    "@yume-chan/scrcpy": "^2.3.0",
    "@yume-chan/scrcpy-decoder-webcodecs": "^2.5.0",
    "@yume-chan/stream-extra": "2.6.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.22.3",
    "node-cron": "^4.2.1",
    "open": "^10.1.0",
    "pg": "^8.21.0",
    "playwright": "^1.60.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "screenshot-desktop": "^1.15.4",
    "ssh2": "^1.16.0",
    "undici": "^6.27.0",
    "ws": "^8.20.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^18.19.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-react": "^4.2.1",
    "drizzle-kit": "^0.31.10",
    "openapi-types": "^12.1.3",
    "portfinder": "^1.0.32",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
